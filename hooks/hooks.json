{
  "description": "Enforces the SipNShip rules: no deletes, no forced pushes, no full test sweeps, no direct edits to generated pages, no issue filed without a State label, no GraphQL call when the hour's budget is nearly spent, no push from a pull request branch whose quick checks fail, no agent dispatched without a fitting model, no serial merge of more than two pull requests without a named mode, no pull request closed without a comment, no detached worktree; each of these follows its rule's switch in .claude/rules-off.txt, and an agent can never flip a switch itself; refuses to finish a task in a worktree that is not clean; and prints the project's live state and the drive's proposal at session start; and notes what an agent did after each refusal, for the console's resolution feed.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 20 session-brief.sh",
            "timeout": 20,
            "statusMessage": "Reading the project's live state"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 10 session-sample.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 20 require-clean-worktree.sh",
            "timeout": 20,
            "statusMessage": "Checking the worktree is clean"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 6 watch-resolution.sh",
            "timeout": 6
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 10 session-sample.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 10 session-sample.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 20 require-clean-worktree.sh",
            "timeout": 20,
            "statusMessage": "Checking the worktree is clean"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 6 watch-resolution.sh",
            "timeout": 6
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 10 session-sample.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-node.sh\" pre-bash",
            "timeout": 90,
            "statusMessage": "Checking the command against the rules"
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 10 --refuse-late require-agent-model.sh",
            "timeout": 10,
            "statusMessage": "Checking the agent's model fits its task"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 10 block-rule-switch.sh",
            "timeout": 10,
            "statusMessage": "Checking the file is not a rule switch"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 10 block-generated-page.sh",
            "timeout": 10,
            "statusMessage": "Checking the file is not a generated page"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 5 watch-resolution.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 5 session-sample.sh tool",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hook-timed.sh\" 10 session-sample.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

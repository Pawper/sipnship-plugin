# Copy to .env and fill in the values. Names only here, never values.
# The console check fails when a name here has no card in console/services.json.

# Hosting
VERCEL_PROJECT=
VERCEL_TEAM=

# Database
DATABASE_URL=

# File storage
STORAGE_BUCKET=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Email
EMAIL_API_KEY=
EMAIL_FROM=

# Sign-in
SESSION_SIGNING_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DNS and domain
PUBLIC_DOMAIN=

# Images and media
MEDIA_CACHE_ZONE=
MEDIA_RELAY_URL=

# Sibling app
SIBLING_APP_URL=

# Backups
BACKUP_BUCKET=

# Source control and CI
GITHUB_REPOSITORY=
# The SipNShip dashboard: a queue drain in CI sends with this repository secret
# (a machine keeps its own token in ~/.sipnship/tokens.json, never here)
SIPNSHIP_REPO_TOKEN=

# Launch to-do flags. Set to 1 when the step is done; the item clears itself.
DONE_RUNNERS=
DONE_BACKUP=
DONE_BRANCH_PROTECTION=
DONE_VERCEL_MACHINE=
DONE_VERCEL_SPEND_CAP=

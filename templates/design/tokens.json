{
  "_comment": "The one source of the project's look. Every platform's palette, type, spacing and icon tables are generated from this file by scripts/design/generate.mjs; a screen uses a token or a type role by name and never a literal colour, size or font. Replace the sample values; keep the keys stable once shipped. outputs names the generated files, one per platform the project has; set an output to null to leave that platform out.",
  "version": 1,
  "outputs": {
    "ts": "src/lib/design.generated.ts",
    "css": "src/app/design.generated.css",
    "kotlin": null,
    "swift": null,
    "fontUrlBase": "/fonts/"
  },
  "ground": [
    { "key": "page", "name": "Page", "hex": "#FBF8F1", "role": "page background" },
    { "key": "panel", "name": "Panel", "hex": "#FFFFFF", "role": "panels, rows, cards" },
    { "key": "line", "name": "Line", "hex": "#E3DED2", "role": "borders and dividers" },
    { "key": "ink", "name": "Ink", "hex": "#1B2638", "role": "main text" },
    { "key": "muted", "name": "Muted", "hex": "#4A5468", "role": "secondary text" }
  ],
  "accents": [
    { "key": "accent", "name": "Accent", "role": "the main button, links", "stops": ["#FF9540", "#FF8A3D", "#FF8264"] }
  ],
  "gradients": [
    { "key": "accent", "accent": "accent", "direction": "to bottom", "offsets": [0, 50, 100] }
  ],
  "type": {
    "families": [
      { "key": "sans", "name": "Figtree", "fallback": "system-ui, sans-serif", "file": "Figtree-Variable.ttf", "weights": [400, 600, 700], "role": "reading and interface" },
      { "key": "display", "name": "Fraunces", "fallback": "Georgia, serif", "file": "Fraunces-Variable.ttf", "weights": [600, 800], "role": "titles" }
    ],
    "roles": [
      { "key": "title", "family": "display", "size": 34, "weight": 800, "lineHeight": 1.05, "letterSpacing": -0.01, "uppercase": false },
      { "key": "body", "family": "sans", "size": 17, "weight": 400, "lineHeight": 1.5, "letterSpacing": 0, "uppercase": false },
      { "key": "label", "family": "sans", "size": 13, "weight": 600, "lineHeight": 1.5, "letterSpacing": 0.06, "uppercase": true },
      { "key": "button", "family": "sans", "size": 17, "weight": 600, "lineHeight": 1.2, "letterSpacing": 0, "uppercase": false }
    ]
  },
  "radii": { "control": 8, "card": 14, "panel": 18, "round": 999 },
  "spacing": { "hitTarget": 44, "gutter": 20, "stackGap": 12, "pageMaxWidth": 576 },
  "iconSizes": { "small": 16, "medium": 24, "large": 48 },
  "blocks": {
    "_comment": "Per-feature values that are design, not data: a ring's size range, a card's aspect. Each block becomes a nested object on every platform.",
    "example": { "ringMin": 24, "ringMax": 48 }
  },
  "iconStroke": { "linecap": "round", "linejoin": "round", "fill": "none" }
}
